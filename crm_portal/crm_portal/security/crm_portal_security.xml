<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="crm_lead_portal_rule" model="ir.rule">
            <field name="name">Portal Lead Rule</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('create_uid', '=', user.id), ('partner_id', '=', user.partner_id.id if user.partner_id else False)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
